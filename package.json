{
  "name": "valueiq",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "ValueIQ Team",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "strata check",
    "arch:serve": "strata serve",
    "test:smoke": "node scripts/smoke.mjs",
    "test:access": "node scripts/access-matrix.mjs",
    "fixtures:forms": "node --experimental-strip-types scripts/generate-form-fixtures.ts",
    "test:forms": "node --experimental-strip-types --test scripts/form-fixtures.test.ts scripts/form-wave2.test.ts && node --experimental-strip-types scripts/generate-form-fixtures.ts --check",
    "test:e2e": "node scripts/e2e-run.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:engine && pnpm test:output && pnpm test:forms && pnpm format:check && pnpm build && pnpm deploy:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply valueiq --local",
    "deploy:check": "wrangler deploy --dry-run",
    "test:engine": "vitest run --config engine/vitest.config.ts",
    "test:output": "node --test scripts/output-contract.test.mjs && node scripts/test-output-publisher.mjs",
    "test:output:integration": "node scripts/test-output-pipeline.mjs",
    "test:output:runtime": "node scripts/test-output-runtime.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.111",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@shadcn/react": "^0.3.1",
    "agents": "^0.23.0",
    "ai": "^7.0.162",
    "better-auth": "1.7.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@edwinzhancn/strata": "0.1.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "prettier": "^3.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.131.1"
  }
}
