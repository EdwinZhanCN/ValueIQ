{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valueiq",
  "main": "workers/app.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./build/client" },
  // Hosts Better Auth may build its base URL from, comma-separated.
  "vars": { "AUTH_ALLOWED_HOSTS": "localhost:*,127.0.0.1:*" },
  // Set locally in .dev.vars; per environment with `wrangler secret put`.
  "secrets": { "required": ["BETTER_AUTH_SECRET", "GEMINI_API_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "ValueIQAgent", "class_name": "ValueIQAgent" }],
  },
  // The calculation run (contract section 1). The instance id is the run id.
  "workflows": [
    {
      "name": "valueiq-run",
      "binding": "RUN_WORKFLOW",
      "class_name": "CalculationRun",
    },
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ValueIQAgent"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "valueiq",
      "migrations_dir": "drizzle",
    },
  ],
  // Private upload bucket; local runs keep objects under .wrangler/state/.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "valueiq-files" }],
  "env": {
    "development": {
      "name": "valueiq-dev",
      "workers_dev": true,
      "vars": { "AUTH_ALLOWED_HOSTS": "valueiq-dev.zhanz.workers.dev" },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "GEMINI_API_KEY"] },
      "durable_objects": {
        "bindings": [{ "name": "ValueIQAgent", "class_name": "ValueIQAgent" }],
      },
      "workflows": [
        {
          "name": "valueiq-dev-run",
          "binding": "RUN_WORKFLOW",
          "class_name": "CalculationRun",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "valueiq-dev",
          "database_id": "b286e047-2af8-46c3-8d46-2d2270478d5c",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "valueiq-dev-files" },
      ],
    },
    "production": {
      "name": "valueiq-prod",
      "workers_dev": true,
      "vars": { "AUTH_ALLOWED_HOSTS": "valueiq-prod.zhanz.workers.dev" },
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
      "durable_objects": {
        "bindings": [{ "name": "ValueIQAgent", "class_name": "ValueIQAgent" }],
      },
      "workflows": [
        {
          "name": "valueiq-prod-run",
          "binding": "RUN_WORKFLOW",
          "class_name": "CalculationRun",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "valueiq-prod",
          // Use a different database from development.
          "database_id": "61439cc5-a8ce-4d2b-ab15-53652cac10ea",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "valueiq-prod-files" },
      ],
    },
  },
}
